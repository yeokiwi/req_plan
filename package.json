{
  "name": "req-plan",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "start:backend": "npm start --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "build": "npm install --prefix backend && npm install --prefix frontend && npm run build:frontend",
    "start": "node --experimental-sqlite --no-warnings=ExperimentalWarning backend/server.js"
  }
}
